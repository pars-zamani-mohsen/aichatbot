# Database Configuration
DATABASE_URL=postgresql://ai_user:your_secure_password@localhost/ai_db

# Security Settings
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Model API Keys
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Email Configuration (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# System Settings
SYSTEM_TIMEZONE=Asia/Tehran
ENABLE_OPENAI=true
ENABLE_GEMINI=true
ENABLE_LOCAL=false

# Environment Settings
DEBUG=false
ENVIRONMENT=production
FRONTEND_URL=
API_BASE_URL=

# Server Settings
PORT=5000
HOST=0.0.0.0

# Database Settings
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_DIRECTORY=knowledge_base
COLLECTION_NAME=website_data

# Model Settings
LOCAL_MODEL_NAME=llama3.2:latest
GEMINI_MODEL_NAME=gemini-2.0-flash
OPENAI_MODEL_NAME=gpt-4.1-nano
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Embeddings Settings
CHUNK_SIZE=500
MAX_TOKENS=8000
TOKENS_PER_MIN=30000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# File Upload Security
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIR=uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,txt,doc,docx
MAX_FILENAME_LENGTH=100

# Input Validation
MAX_INPUT_LENGTH=1000
MAX_MESSAGE_LENGTH=500
MAX_URL_LENGTH=2048

# ChromaDB Settings
CHROMA_PERSIST_DIRECTORY=chroma_db
CHROMA_ANONYMIZED_TELEMETRY=false

# CORS Settings
# Development: CORS_ORIGINS="" (خالی بگذارید تا همه origins مجاز باشند)
# Production: CORS_ORIGINS="https://your-domain.com,https://www.your-domain.com"
CORS_ORIGINS=""
CORS_ALLOW_CREDENTIALS=true

# Security Headers
ENABLE_HSTS=true
ENABLE_CSP=true
ENABLE_XSS_PROTECTION=true

# Session Security
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30
PASSWORD_MIN_LENGTH=8
REQUIRE_EMAIL_VERIFICATION=true
ENABLE_TWO_FACTOR=false

# Chat Settings
MAX_CHAT_HISTORY=7
SIMILARITY_THRESHOLD=0.5
MAX_PAGES=100
