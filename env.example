# ===========================================
# 🌐 NETWORK CONFIGURATION
# ===========================================
# IP سرور - فقط اینجا تغییر دهید
SERVER_IP=localhost

# ===========================================
# 🔌 PORT CONFIGURATION
# ===========================================
# پورت‌های سرویس‌ها - در صورت نیاز تغییر دهید
BACKEND_PORT=5000
FRONTEND_PORT=3001
DATABASE_PORT=5445
REDIS_PORT=6397
CHROMA_PORT=8802
NGINX_HTTP_PORT=8380
NGINX_HTTPS_PORT=8443

# ===========================================
# 🌍 CORS CONFIGURATION
# ===========================================
# CORS Origins - خودکار از SERVER_IP و پورت‌ها محاسبه می‌شود
# CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# ===========================================
# 🐳 DOCKER CONFIGURATION
# ===========================================
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=ai_password
POSTGRES_DB=ai_chatbot
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ai_user:ai_password@db:5432/ai_chatbot

# ===========================================
# 🔐 SECURITY
# ===========================================
SECRET_KEY=your_very_secure_secret_key_here_change_this_in_production
DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# 🤖 AI CONFIGURATION
# ===========================================
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
GEMINI_MODEL_NAME=gemini-pro
OPENAI_MODEL_NAME=gpt-3.5-turbo

# ===========================================
# 📧 EMAIL CONFIGURATION
# ===========================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ===========================================
# 📊 RATE LIMITING
# ===========================================
RATE_LIMIT_PER_MINUTE=200
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_CHAT_PER_MINUTE=100
RATE_LIMIT_CRAWL_PER_HOUR=20
RATE_LIMIT_WIDGET_PER_HOUR=100

# ===========================================
# 📁 FILE UPLOAD
# ===========================================
MAX_FILE_SIZE=50MB
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,md,jpg,jpeg,png
UPLOAD_DIR=uploads

# ===========================================
# 🔍 CRAWLER SETTINGS
# ===========================================
MAX_PAGES=100
MAX_DEPTH=3
CHUNK_SIZE=500
CHUNK_OVERLAP=200

# ===========================================
# 📊 MONITORING & LOGGING
# ===========================================
LOG_LEVEL=INFO
ENABLE_METRICS=true
METRICS_PORT=9090

# ===========================================
# 🌐 REDIS CONFIGURATION
# ===========================================
REDIS_URL=redis://redis:6379/0

# ===========================================
# 🗄️ CHROMADB CONFIGURATION
# ===========================================
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=chroma_db

# ===========================================
# 👤 ADMIN USER CONFIGURATION
# ===========================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456#