# Database Configuration
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=ai_password
POSTGRES_DB=ai_chatbot

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Security
SECRET_KEY=your_very_secure_secret_key_here_change_this_in_production

# Environment
ENVIRONMENT=production
DEBUG=false

# RAG Settings
CHUNK_SIZE=500

# Redis Configuration
REDIS_URL=redis://redis:6379

# Application URLs
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:5000
API_BASE_URL=http://localhost:5000

# Database URLs
DATABASE_URL=postgresql://ai_user:ai_password@db:5432/ai_chatbot

# Rate Limiting
RATE_LIMIT_CRAWL_PER_HOUR=50
RATE_LIMIT_API_PER_MINUTE=200

# File Upload Limits
MAX_FILE_SIZE=50MB
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,md

# ChromaDB Configuration
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=/app/chroma_db

# Admin User Configuration
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD="admin123456#"

# Ollama Configuration (Optional) - DISABLED
# OLLAMA_API_URL=http://ollama:11434
# OLLAMA_MODEL=llama2

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
